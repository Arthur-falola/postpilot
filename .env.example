# Base de données PostgreSQL — Alwaysdata
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/NOM_BASE?sslmode=require
# Trouvable dans ton panneau Alwaysdata > Bases de données > PostgreSQL
DATABASE_URL="postgresql://user:password@postgresql-xxx.alwaysdata.net:5432/xxx_postpilot?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genere-avec: openssl rand -base64 32"

# Google OAuth (console.cloud.google.com > Identifiants > ID client OAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Meta / Facebook (developers.facebook.com)
META_APP_ID=""
META_APP_SECRET=""
# Chaîne que TU choisis toi-même (ex: un mot de passe aléatoire) — à renseigner
# aussi dans le tableau de bord Meta > Webhooks lors de la config
META_WEBHOOK_VERIFY_TOKEN=""

# IA (Anthropic — génération des posts)
ANTHROPIC_API_KEY=""

# Cron de publication (secret partagé pour sécuriser /api/cron/publish)
CRON_SECRET="genere-avec: openssl rand -base64 32"
